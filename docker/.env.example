# TJ Plex Media Manager - Docker Environment Variables
# Copy this file to .env and update the values

# Port to expose the application (default: 8080)
APP_PORT=8080

# Encryption key for securing Plex tokens (generate a random 32+ character string)
# You can generate one with: openssl rand -hex 32
ENCRYPTION_KEY=your-secure-encryption-key-here-minimum-32-chars

# Authentication (optional — leave both blank to disable auth)
# When set, all routes require login
AUTH_USERNAME=
AUTH_PASSWORD=

# JWT secret for session tokens (auto-generated if not set, but set one for persistence across restarts)
# Generate with: openssl rand -hex 64
JWT_SECRET=
